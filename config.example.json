{
  "room": {
    "name": "MCU Room",
    "auto_create": true
  },
  "sip": {
    "listen": "0.0.0.0",
    "port": 5060,
    "transport": "udp",
    "allowed_peers": [],
    "require_encryption": false,
    "codecs": {
      "audio": [
        "opus/48000/2",
        "G722/16000/1",
        "PCMU/8000/1",
        "PCMA/8000/1",
        "G729/8000/1"
      ],
      "video": [
        "H264/90000",
        "H265/90000",
        "VP8/90000"
      ]
    }
  },
  "media": {
    "video": {
      "width": 1280,
      "height": 720,
      "fps": 30,
      "bitrate_kbps": 1500
    },
    "audio": {
      "bitrate_kbps": 48,
      "echo_cancel": true,
      "noise_suppress": true
    },
    "bandwidth_kbps": 4000
  },
  "h323": {
    "enabled": false,
    "port": 1720
  },
  "features": {
    "allow_screen_share": true,
    "allow_recording": true,
    "recording_path": "./recordings"
  }
}
