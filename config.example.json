{
  "room": {
    "name": "MCU Room",
    "auto_create": true
  },
  "sip": {
    "listen": "0.0.0.0",
    "port": 5060,
    "transport": "udp",
    "allowed_peers": [],
    "require_encryption": false,
    "srtp": "",
    "max_calls": 16,
    "auto_answer": true,
    "stun": {
      "server": "",
      "enable_ice": true
    },
    "nat": {
      "public_address": "",
      "turn_server": "",
      "turn_user": "",
      "turn_password": "",
      "turn_transport": "udp",
      "keep_alive_sec": 15,
      "rewrite_contact": true,
      "ice_trickle": "off",
      "report_nat_type_in_sdp": 1
    },
    "interop": {
      "prack": "off",
      "session_timer": "optional",
      "session_expires_sec": 1800,
      "min_session_expires_sec": 900,
      "hold_type": "rfc3264",
      "rtcp_mux": "off"
    },
    "codecs": {
      "audio": [
        "PCMU/8000/1",
        "PCMA/8000/1",
        "G722/16000/1",
        "G7221/16000/1",
        "G7221/32000/1",
        "G7221/48000/1",
        "G719/48000/1",
        "G723/8000/1",
        "G728/8000/1",
        "G729/8000/1",
        "opus/48000/2"
      ],
      "video": [
        "H264/90000",
        "H263/90000",
        "H263-1998/90000",
        "H261/90000",
        "H265/90000",
        "VP8/90000",
        "VP9/90000"
      ]
    },
    "registration": {
      "enabled": false,
      "registrar": "",
      "domain": "",
      "username": "",
      "password": "",
      "expires_sec": 3600,
      "proxies": [],
      "retry_interval_sec": 60
    }
  },
  "media": {
    "video": {
      "enabled": true,
      "width": 1280,
      "height": 720,
      "fps": 30,
      "bitrate_kbps": 1500
    },
    "audio": {
      "bitrate_kbps": 48,
      "echo_cancel": true,
      "noise_suppress": true
    },
    "bandwidth_kbps": 4000
  },
  "h323": {
    "enabled": false,
    "port": 1720
  },
  "features": {
    "allow_screen_share": true,
    "allow_recording": true,
    "recording_path": "./recordings",
    "rtcp_poll_interval": 3.0,
    "layouts": {
      "available": [
        "speaker",
        "gallery_2x2",
        "gallery_3x3",
        "grid_auto"
      ],
      "default": "speaker"
    },
    "virtual_camera": false,
    "virtual_camera_device": "/dev/video0",
    "default_call_protocol": "auto",
    "web": {
      "enabled": false,
      "host": "0.0.0.0",
      "port": 8080,
      "auth_token": "",
      "tls": false,
      "cert_file": "",
      "key_file": "",
      "ice_servers": [],
      "turn_user": "",
      "turn_password": "",
      "mediasoup": {
        "enabled": false,
        "host": "127.0.0.1",
        "port": 4443,
        "token": "",
        "workers": 0,
        "rtc_min": 40000,
        "rtc_max": 40100,
        "announced_ip": "",
        "listen_ip": "0.0.0.0",
        "log_level": "warn"
      }
    }
  }
}
