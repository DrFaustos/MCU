# Скопируйте в .env и заполните под своё окружение.
#
# Внешний IP или домен этой машины, который увидят браузеры. Обязательно:
# за NAT без него ICE-кандидаты будут недостижимы.
ANNOUNCED_IP=203.0.113.10

# Учётка TURN (используется coturn и приложением).
TURN_USER=mcu
TURN_PASSWORD=change-me-please

# mediasoup: число worker'ов (0 = по числу ядер, не больше 4).
MCU_MEDIASOUP_WORKERS=0
# Диапазон UDP-портов медиа. Должен быть открыт на файрволе.
MCU_MEDIASOUP_RTC_MIN=40000
MCU_MEDIASOUP_RTC_MAX=40100
# Уровень логов mediasoup: error|warn|info|debug.
MEDIASOUP_LOG_LEVEL=warn

# Имя стека: подставляетcя в имя compose-проекта и в container_name
# (<имя>-mediasoup, <имя>-coturn). По умолчанию 'mcu'. Нужно, чтобы на одной
# машине поднялись две стойки (например worktree линии sip и линии h323):
# MCU_STACK_NAME=mcu-h323 docker compose up -d --build
MCU_STACK_NAME=mcu

# Хост-порт signaling/health у mediasoup-sidecar (в контейнере всегда 4443).
# Второй стойке нужен другой порт: MCU_MEDIASOUP_HTTP_PORT=14443
MCU_MEDIASOUP_HTTP_PORT=4443

# Порт прослушивания STUN/TURN (coturn в host-сети): второй стойке нужен
# другой, напр. TURN_LISTEN_PORT=13478.
TURN_LISTEN_PORT=3478
